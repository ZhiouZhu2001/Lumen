POSTGRES_USER=lumen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lumen

# Backend on the host (loopback data ports from compose.host.yml)
DATABASE_URL=postgresql+asyncpg://lumen:change_me@localhost:5434/lumen
REDIS_URL=redis://localhost:6381/0
SQL_ECHO=false

# Google Books API
GOOGLE_BOOKS_API_KEY=

# OPENAI API
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-5.4-mini

# Actual outbound model HTTP attempts per UTC day, including failed retries.
DAILY_AI_CALL_CAP=100
# Exact trusted reverse-proxy IPs/CIDRs as a JSON array. Empty means direct peers.
# Run Uvicorn with --no-proxy-headers; configure only your controlled proxy peers.
# The full container stack derives its trusted peer from LUMEN_PROXY_IP instead.
TRUSTED_PROXY_IPS=[]

# Full container stack: only Caddy publishes ports, on loopback by default.
LUMEN_BIND_ADDRESS=127.0.0.1
LUMEN_HTTP_PORT=8080
LUMEN_HTTPS_PORT=8443
LUMEN_SITE_ADDRESS=:80
# A dedicated bridge gives the controlled Caddy peer one exact trusted address.
# Keep the fixed IP outside the dynamic range; change all three on overlap.
LUMEN_PROXY_SUBNET=172.30.19.0/28
LUMEN_PROXY_DYNAMIC_RANGE=172.30.19.8/29
LUMEN_PROXY_IP=172.30.19.2
