POSTGRES_USER=lumen
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lumen

# Backend, running on the host (host ports from docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://lumen:change_me@localhost:5434/lumen
REDIS_URL=redis://localhost:6381/0
SQL_ECHO=false

# Google Books API
GOOGLE_BOOKS_API_KEY=

# OPENAI API
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-5.4-mini

# Actual outbound model HTTP attempts per UTC day, including failed retries.
DAILY_AI_CALL_CAP=100
# Exact trusted reverse-proxy IPs/CIDRs as a JSON array. Empty means direct peers.
# Run Uvicorn with --no-proxy-headers; configure only your controlled proxy peers.
TRUSTED_PROXY_IPS=[]
