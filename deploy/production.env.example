# Review and copy privately to /srv/lumen/.env only after deployment approval.
POSTGRES_USER=lumen
# Use a unique high-entropy URL-safe password; Compose embeds it in a URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET
POSTGRES_DB=lumen
OPENAI_API_KEY=
GOOGLE_BOOKS_API_KEY=
LLM_MODEL=openai:gpt-5.4-mini
DAILY_AI_CALL_CAP=100
SQL_ECHO=false

# Unapproved example: replace with the owned domain before allowing public traffic.
LUMEN_SITE_ADDRESS=books.example.invalid
LUMEN_BIND_ADDRESS=0.0.0.0
LUMEN_HTTP_PORT=80
LUMEN_HTTPS_PORT=443
LUMEN_PROXY_SUBNET=172.30.19.0/28
LUMEN_PROXY_DYNAMIC_RANGE=172.30.19.8/29
LUMEN_PROXY_IP=172.30.19.2
LUMEN_BACKUP_PG_PORT=5434
