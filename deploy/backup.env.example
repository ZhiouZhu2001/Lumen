# Copy privately to /etc/lumen/backup.env after reviewing the deployment proposal.
# URL-encode special characters in the password; use the actual loopback mapping.
DATABASE_URL=postgresql+asyncpg://lumen:REPLACE_WITH_URL_ENCODED_SECRET@127.0.0.1:5434/lumen
# Required settings field; the backup command does not connect to Redis.
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
GOOGLE_BOOKS_API_KEY=
SQL_ECHO=false
DAILY_AI_CALL_CAP=100
